{
  "name": "@stattic/routing",
  "version": "0.0.11",
  "license": "MIT",
  "description": "Stattic routing, configuration and Builder WASI host.",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "bun": ">=1.3.11",
    "node": ">=20"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc -b --force tsconfig.build.json && node scripts/copy-finalizer-wasm.mjs",
    "prepack": "bun run build",
    "pretest": "node scripts/copy-finalizer-wasm.mjs",
    "test": "bun test ./src/*.test.ts ./scripts/*.test.mjs",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "exports": {
    "./compile": {
      "types": "./dist/compile.d.ts",
      "import": "./dist/compile.js"
    },
    "./plan": {
      "types": "./dist/plan.d.ts",
      "import": "./dist/plan.js"
    },
    "./match": {
      "types": "./dist/match.d.ts",
      "import": "./dist/match.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    },
    "./protocol": {
      "types": "./dist/protocol.generated.d.ts",
      "import": "./dist/protocol.generated.js"
    },
    "./prepare": {
      "types": "./dist/prepare.d.ts",
      "import": "./dist/prepare.js"
    },
    "./finalize": {
      "types": "./dist/finalize.d.ts",
      "import": "./dist/finalize.js"
    },
    "./prepare-browser": {
      "types": "./dist/prepare-browser.d.ts",
      "import": "./dist/prepare-browser.js"
    },
    "./strict-config": {
      "types": "./dist/strict-config.d.ts",
      "import": "./dist/strict-config.js"
    }
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "typescript": "^6.0.3"
  }
}
