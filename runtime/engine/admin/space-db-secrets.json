{
  "about": "Names of WordPress option and meta rows whose values Space data (admin/space-db.php) never reads out, filters on or writes. `names` mirrors the unreadable option rules in crates/spacepress/runtime/SpacePress/Wp/guard.json (runtime/tests/space-db.test.ts fails when they drift); `spacefast` also protects pre-rename tp_ options and the sealed keys Spacefast's identity plugin stores as options. A name is compared trimmed and lowercased, and a name with a byte outside printable ASCII counts as secret.",
  "names": [
    { "match": "prefix", "name": "new_user_" },
    { "match": "exact", "name": "adminhash" },
    { "match": "exact", "name": "recovery_keys" },
    { "match": "exact", "name": "secret_key" },
    { "match": "exact", "name": "auth_key" },
    { "match": "exact", "name": "auth_salt" },
    { "match": "exact", "name": "secure_auth_key" },
    { "match": "exact", "name": "secure_auth_salt" },
    { "match": "exact", "name": "logged_in_key" },
    { "match": "exact", "name": "logged_in_salt" },
    { "match": "exact", "name": "nonce_key" },
    { "match": "exact", "name": "nonce_salt" },
    { "match": "exact", "name": "mailserver_pass" },
    { "match": "prefix", "name": "sp_" },
    { "match": "contains", "name": "secret" },
    { "match": "contains", "name": "token" },
    { "match": "contains", "name": "private" },
    { "match": "contains", "name": "password" },
    { "match": "contains", "name": "passwd" },
    { "match": "contains", "name": "credential" },
    { "match": "contains", "name": "api_key" },
    { "match": "contains", "name": "apikey" },
    { "match": "contains", "name": "access_key" },
    { "match": "suffix", "name": "_salt" }
  ],
  "spacefast": [
    { "match": "prefix", "name": "tp_" },
    { "match": "prefix", "name": "sfi_" },
    { "match": "exact", "name": "_two_factor_totp_key" },
    { "match": "exact", "name": "_two_factor_backup_codes" }
  ]
}
